#include <iostream>
using namespace std;

int main()
{
    int n = 10;
    int i = 1;

    int k = 1;
    while (k < n)
    {
        int j = 1;
        while (j <= i)
        {
            cout << k << " ";
            j++;
            k++;
        }
        cout << endl;
        i++;
    }

    return 0;
}

